# Zephyr build folders
/build/
/build_*/

# Zephyr logs
log*.txt

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Secret keys
**/keys/private/*

# Local Kconfig overrides (real device secrets): each sample's prj.local.conf
# and, beside a board's own conf, boards/<board>.local.conf. samples/common/
# app.cmake merges both when present.
*.local.conf

# Agent guidance, local to a working copy
/CLAUDE.md

# Python venv
.venv/

# Cache
.cache/

# West deps (fetched via `west update`, not part of this repo)
/mbedtls/
/nrf/
/nrfxlib/
/pcf85063a/
/tools/
/modules/
/bootloader/
/zephyr/
# No trailing slash: pigeon is a symlink to a local checkout, and a
# trailing-slash pattern only matches real directories, not symlinks.
/pigeon

# Local reference copy, not part of this repo.
/nidd-sample/

# Cortex debugging states
.vscode/.cortex-debug.registers.state.json

# native_sim writes its flash simulator file into the working directory
flash.bin
