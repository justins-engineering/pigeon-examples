rsource "../Kconfig.sysbuild.signing"

# native_sim and the ESP32-C6 boot the application image directly. The
# Feathers boot through MCUboot: without it the image links into the SoC's
# default partition and a mass-erased chip has nothing at address 0.
choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if SOC_SERIES_NRF91
	default BOOTLOADER_NONE
endchoice

source "share/sysbuild/Kconfig"
