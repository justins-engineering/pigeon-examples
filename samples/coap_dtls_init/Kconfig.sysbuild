# esp32c6_devkitc's own Kconfig.sysbuild defaults BOOTLOADER to MCUboot, but
# this sample has no signing key or CONFIG_PIGEON_FOTA wired up for that
# board -- there's no second slot to build against, so force it back off,
# same as ws_init/wifi_init.
#
# circuitdojo_feather (nRF9160) carries no board-level default of its own
# and would otherwise land on the global BOOTLOADER_NONE default: the app
# image gets linked straight into the SoC's default flash partition, which
# only boots because a real chip normally still has whatever bootloader was
# there before. A blank/mass-erased chip has nothing at address 0 and hard-
# faults immediately. Opt in explicitly here, matching https_init.
choice BOOTLOADER
	default BOOTLOADER_NONE if BOARD_ESP32C6_DEVKITC
	default BOOTLOADER_MCUBOOT if SOC_SERIES_NRF91
endchoice

if BOOTLOADER_MCUBOOT

choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_ECDSA_P256
endchoice

endif

source "share/sysbuild/Kconfig"
