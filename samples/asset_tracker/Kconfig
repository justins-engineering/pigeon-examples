menu "Asset tracker sample"

config ASSET_TRACKER_SIM_GPS
  bool "Report a simulated track instead of real GNSS fixes" if SOC_SERIES_NRF91
  default y if !SOC_SERIES_NRF91
  help
    A real receiver exists only on the nRF91 modem, so every other board
    reports a fabricated circuit around the base coordinate below. On a
    Feather it is the indoor option, where GNSS will very likely never fix.
    A simulated sample reports gps_fix_quality 2 rather than 1, so a
    dashboard can never mistake it for a real fix.

if ASSET_TRACKER_SIM_GPS

config ASSET_TRACKER_SIM_BASE_LAT
  string "Simulated track centre latitude (decimal degrees)"
  default "45.523064"

config ASSET_TRACKER_SIM_BASE_LON
  string "Simulated track centre longitude (decimal degrees)"
  default "-122.676483"

config ASSET_TRACKER_SIM_RADIUS_M
  int "Simulated circuit radius (metres)"
  default 50
  help
    Small enough to read as an asset moving around one yard rather than a
    vehicle on a highway.

config ASSET_TRACKER_SIM_PERIOD_SEC
  int "Seconds per simulated lap"
  range 10 86400
  default 300
  help
    With the radius above, this is what sets the reported gps_speed_mps.

endif # ASSET_TRACKER_SIM_GPS

if !ASSET_TRACKER_SIM_GPS

config ASSET_TRACKER_GNSS_FIX_INTERVAL_SEC
  int "Seconds between periodic GNSS fixes"
  range 10 65535
  default 120
  help
    Periodic navigation leaves the modem more of the shared radio for LTE
    between fixes than continuous mode does.

config ASSET_TRACKER_GNSS_FIX_RETRY_SEC
  int "Seconds GNSS may search before abandoning one fix"
  range 0 65535
  default 120
  help
    Unbounded, the receiver keeps searching until the next interval even
    where a fix can never come.

endif # !ASSET_TRACKER_SIM_GPS

config ASSET_TRACKER_CONNECT_MAX_ROUNDS
  int "Network connect attempts before rebooting"
  default 5
  help
    Nothing else recovers a device that never reaches the network: the
    watchdog feeds on a successful report, and a modem inside its
    reset-loop restriction fails to attach once and then sits idle.

config ASSET_TRACKER_CONNECT_BACKOFF_BASE_SEC
  int "Backoff before the second connect attempt (seconds)"
  default 30
  help
    An attempt usually fails for a reason seconds will not clear, so the
    first retry already waits.

config ASSET_TRACKER_CONNECT_BACKOFF_MAX_SEC
  int "Backoff ceiling between connect attempts (seconds)"
  default 300
  help
    The backoff doubles each round up to this.

module = ASSET_TRACKER
module-str = Asset tracker sample
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
