rsource "../Kconfig.sysbuild.signing"

# A Feather has nothing at address 0 without MCUboot, and boots TF-M through
# it. The ESP32-C6 board defaults to MCUboot; this sample stages no update, so
# a single image is enough there and on native_sim.
choice BOOTLOADER
	default BOOTLOADER_NONE if BOARD_ESP32C6_DEVKITC
	default BOOTLOADER_MCUBOOT if SOC_SERIES_NRF91
endchoice

source "share/sysbuild/Kconfig"
