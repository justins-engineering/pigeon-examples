rsource "../Kconfig.sysbuild.signing"

# native_sim has no bootloader or second slot; every other board boots through
# MCUboot, which is where FOTA stages an image.
choice BOOTLOADER
	default BOOTLOADER_NONE if BOARD_NATIVE_SIM
	default BOOTLOADER_MCUBOOT
endchoice

source "share/sysbuild/Kconfig"
