/* i2c1 shares its peripheral instance with the trace UART below. */
&i2c1 {
    status = "disabled";
};

/* Modem trace UART. */
&uart1 {
    status = "okay";
    current-speed = <1000000>;
    pinctrl-0 = <&uart1_alt>;
    pinctrl-1 = <&uart1_sleep_alt>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    uart1_alt: uart1_alt {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 24)>,
                <NRF_PSEL(UART_RX, 0, 23)>;
        };
    };

    uart1_sleep_alt: uart1_sleep_alt {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 24)>,
                <NRF_PSEL(UART_RX, 0, 23)>;
            low-power-enable;
        };
    };
};

&uart0 {
  status = "okay";
  compatible = "nordic,nrf-uarte";
  current-speed = <1000000>;
  pinctrl-0 = <&uart0_default>;
  pinctrl-1 = <&uart0_sleep>;
  pinctrl-names = "default", "sleep";
};

&rtc0 {
  status = "okay";
  /* 32768 Hz / (4095 + 1) = 8 Hz. */
  prescaler = <4095>;
  wakeup-source;
};

/* The modem trace buffer fits in the slack the stock partition file leaves
 * inside the modem shared-memory region, so nothing else has to move.
 * Nordic's own modem-trace snippet sizes it for a different SRAM total and
 * overflows this board. */
&sram0_ns_modem {
  cpucell_cpuapp_ipc_shm_trace: sram0_ns_modem@4568 {
    reg = <0x4568 0x4000>;
  };
};

/* The stock 256/192 KiB secure/non-secure split leaves TF-M most of its
 * share unused while this application overflows its own. The slot total is
 * unchanged, so MCUboot's overlay needs nothing. */
/delete-node/ &slot0_s_partition;
/delete-node/ &slot0_ns_partition;

&slot0_partition {
  slot0_s_partition: partition@0 {
    compatible = "zephyr,mapped-partition";
    label = "image-0-secure";
    reg = <0x00000000 0x00020000>;
  };

  slot0_ns_partition: partition@20000 {
    compatible = "zephyr,mapped-partition";
    label = "image-0-nonsecure";
    reg = <0x00020000 0x00050000>;
  };
};

/delete-node/ &slot1_s_partition;
/delete-node/ &slot1_ns_partition;

&slot1_partition {
  slot1_s_partition: partition@0 {
    compatible = "zephyr,mapped-partition";
    label = "image-1-secure";
    reg = <0x00000000 0x00020000>;
  };

  slot1_ns_partition: partition@20000 {
    compatible = "zephyr,mapped-partition";
    label = "image-1-nonsecure";
    reg = <0x00020000 0x00050000>;
  };
};

/ {
  chosen {
    zephyr,console = &uart0;
    zephyr,shell-uart = &uart0;
    nordic,modem-trace-uart = &uart1;
  };

  aliases {
    rtc = &rtc0;
  };
};
